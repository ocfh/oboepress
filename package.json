{
  "name": "oboepress",
  "version": "1.0.0",
  "private": true,
  "description": "A Serverless-ready Headless + Hybrid CMS (Next.js + Drizzle + Postgres + GraphQL) deployable on Vercel.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "cd db && drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "cd db && drizzle-kit push --config=drizzle.config.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:seed-demo": "tsx db/seed-demo.ts",
    "db:reset": "tsx db/reset.ts",
    "db:sql": "tsx db/sql.ts",
    "db:studio": "cd db && drizzle-kit studio --config=drizzle.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@vercel/blob": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.7.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.0.9",
    "next": "14.2.18",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
