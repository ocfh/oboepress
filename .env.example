# ---- Database driver ----
# Local dev (default): pglite — embedded in-process Postgres (WASM), zero config,
#   NO Docker, NO external server. Just run `npm run dev` and the .data/ folder is
#   created automatically. Tables are migrated on first launch.
# Production (Vercel / Neon): postgres — set DB_DRIVER=postgres and a real DATABASE_URL.
DB_DRIVER=pglite
# pglite data directory (optional override; defaults to ./.data/oboepress_main).
# IMPORTANT: never use ./.data/oboe-press — that path is a native Postgres data
#   directory and is incompatible with pglite (opening it aborts the WASM).
DATABASE_URL=./.data/oboepress_main
# For production uncomment and set:
# DB_DRIVER=postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---- Auth ----
# OPTIONAL in local dev: if omitted, OboePress auto-generates a random secret and
#   persists it to ./.data/.auth-secret so sessions survive restarts.
# REQUIRED in production: set a long random string (>= 16 chars) for stable sessions.
# Generate one with:  openssl rand -base64 32
# AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars

# ---- Object Storage (Vercel Blob) ----
# Create a Blob store in the Vercel dashboard and copy the token.
# Leave empty to fall back to local public/uploads (dev only, not persisted on Vercel).
BLOB_READ_WRITE_TOKEN=

# ---- Site ----
SITE_URL=http://localhost:3000
